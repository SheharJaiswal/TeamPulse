{
  "ConnectionStrings": {
    "IdentityDatabase": "Server=localhost;Port=3306;Database=teampulse_identity;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": {
    "Issuer": "TeamPulse.Identity",
    "Audience": "TeamPulse.Services",
    "AccessTokenMinutes": 30
  },
  "OutboxDispatcher": {
    "Enabled": false,
    "PollIntervalSeconds": 2,
    "BatchSize": 10,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 10,
    "BaseRetryDelaySeconds": 1,
    "MaxRetryDelaySeconds": 300,
    "SystemicFailurePauseSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
