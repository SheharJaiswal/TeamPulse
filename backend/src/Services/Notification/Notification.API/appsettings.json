{
  "ConnectionStrings": {
    "NotificationDatabase": "Server=localhost;Port=3306;Database=teampulse_notification;User=teampulse_app;Password=local_teampulse_password;"
  },
  "NotificationConsumer": {
    "Enabled": false,
    "Uri": "amqp://teampulse:local_rabbitmq_password@localhost:5672/",
    "QueueName": "teampulse.notification.events",
    "PrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryBaseDelayMilliseconds": 250,
    "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
