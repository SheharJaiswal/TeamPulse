{
  "ConnectionStrings": {
    "HabitDatabase": "Server=localhost;Port=3306;Database=teampulse_habit;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": {
    "Issuer": "TeamPulse.Identity",
    "Audience": "TeamPulse.Services"
  },
  "HabitConsumer": {
    "Enabled": false,
    "QueueName": "teampulse.habit.events",
    "PrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryBaseDelayMilliseconds": 250,
    "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
