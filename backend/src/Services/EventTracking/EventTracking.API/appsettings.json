{
  "ConnectionStrings": {
    "EventTrackingDatabase": "Server=localhost;Port=3306;Database=teampulse_event_tracking;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": { "Issuer": "TeamPulse.Identity", "Audience": "TeamPulse.Services" },
  "HabitApi": { "BaseUrl": "http://localhost:5102/" },
  "ChallengeApi": { "BaseUrl": "http://localhost:5104/" },
  "EventTrackingConsumer": {
    "Enabled": false, "QueueName": "teampulse.event-tracking.events", "PrefetchCount": 1,
    "MaxProcessingAttempts": 3, "RetryBaseDelayMilliseconds": 250, "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "EventTrackingPublisher": {
    "Uri": "amqp://teampulse:local_rabbitmq_password@localhost:5672/",
    "ExchangeName": "teampulse.domain.events", "RoutingKey": "habit.activity.recorded"
  },
  "EventTrackingOutbox": {
    "Enabled": false, "PollIntervalSeconds": 2, "BatchSize": 10, "LeaseDurationSeconds": 60,
    "MaxAttempts": 10, "BaseRetryDelaySeconds": 1, "MaxRetryDelaySeconds": 300
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
