{
  "ConnectionStrings": {
    "EventTrackingDatabase": "Server=localhost;Port=3306;Database=teampulse_event_tracking;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": {
    "Issuer": "TeamPulse.Identity",
    "Audience": "TeamPulse.Services"
  },
  "HabitApi": {
    "BaseUrl": "http://localhost:5102/"
  },
  "EventTrackingConsumer": {
    "Enabled": false,
    "QueueName": "teampulse.event-tracking.events",
    "PrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryBaseDelayMilliseconds": 250,
    "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
