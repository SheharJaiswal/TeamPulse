{
  "ConnectionStrings": {
    "ChallengeDatabase": "Server=localhost;Port=3306;Database=teampulse_challenge;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": {
    "Issuer": "TeamPulse.Identity",
    "Audience": "TeamPulse.Services"
  },
  "Identity": {
    "BaseUrl": "https://localhost:61329"
  },
  "ChallengeInvitationEmail": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@teampulse.local",
    "FromName": "TeamPulse",
    "ApplicationBaseUrl": "http://localhost:5173/challenges"
  },
  "ChallengeConsumer": {
    "Enabled": false,
    "QueueName": "teampulse.challenge.events",
    "PrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryBaseDelayMilliseconds": 250,
    "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}