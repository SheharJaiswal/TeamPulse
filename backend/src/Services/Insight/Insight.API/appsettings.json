{
  "ConnectionStrings": {
    "InsightActivityDatabase": "Server=localhost;Port=3306;Database=teampulse_insight;User=teampulse_app;Password=local_teampulse_password;"
  },
  "Jwt": {
    "Issuer": "TeamPulse.Identity",
    "Audience": "TeamPulse.Services"
  },
  "InsightConsumer": {
    "Enabled": false,
    "Uri": "amqp://teampulse:local_rabbitmq_password@localhost:5672/",
    "QueueName": "teampulse.insight.events",
    "PrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryBaseDelayMilliseconds": 250,
    "RetryMaxDelayMilliseconds": 2000,
    "ReconnectDelayMilliseconds": 5000
  },
  "InsightActivityConsumer": {
    "Enabled": false,
    "Uri": "amqp://teampulse:local_rabbitmq_password@localhost:5672/",
    "QueueName": "teampulse.insight.activity.events",
    "PrefetchCount": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
